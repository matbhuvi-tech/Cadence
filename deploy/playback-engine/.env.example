# Copy to .env beside compose.yml (or compose.hardened.yml), then replace every value.
# Internal engine data (/var/lib/cadence) uses the Docker-managed `cadence_data` volume by default.
CADENCE_IMAGE=ghcr.io/matbhuvi-tech/cadence-playback-engine:REPLACE_WITH_RELEASE
CADENCE_ADVERTISED_IP=192.168.1.50
CADENCE_HOST_MUSIC_DIR=/srv/music
CADENCE_LABEL=Cadence Playback Engine
