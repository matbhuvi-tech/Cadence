# Copy to keystore.properties (ignored by git) to sign release APKs/AABs:
# keytool -genkeypair -v -keystore cadence-remote-release.jks -alias cadence-remote -keyalg RSA -keysize 2048 -validity 10000
storeFile=../cadence-remote-release.jks
storePassword=CHANGE_ME
keyAlias=cadence-remote
keyPassword=CHANGE_ME

