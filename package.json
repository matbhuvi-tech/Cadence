{
  "name": "music-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "npm run --prefix pwa dev",
    "build:pwa": "npm run --prefix pwa build",
    "build": "npm run build:pwa && tsc -b && vite build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/windows-suite/build-windows-suite.ps1 -BuildComponents -RequireInstaller",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/test-frontend.mjs --live",
    "test:ci": "npm run lint && npm run build && npm test",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test:engine": "tsx src/test/verifyEngine.ts",
    "test:pilot": "tsx src/test/testCadenceCopilotMatrix.ts",
    "test:norm": "vitest run src/test/testNormalizationRules.test.ts",
    "test:backdrop": "vitest run src/test/testBackdropAnalyzer.test.ts",
    "test:artists": "vitest run src/test/testArtistTokenizer.test.ts",
    "test:audit": "vitest run src/test/testAuditHygieneDataBinding.test.ts",
    "test:commit": "vitest run src/test/testCommitArchitecture.test.ts",
    "test:cyclic": "vitest run src/test/testCyclicNormalizationFix.test.ts",
    "test:startup": "vitest run src/test/testAppStartup.test.ts",
    "test:provenance": "vitest run src/test/testCanonicalProvenance.test.ts",
    "test:trace": "vitest run src/test/testCurationDecisionTrace.test.ts",
    "test:queue-sync": "vitest run src/test/testRemoteQueueSync.test.ts",
    "test:endpoint-routing": "vitest run src/test/testEndpointRouting.test.ts",
    "test:engine-session": "vitest run src/test/testEngineSession.test.ts",
    "test:core-services": "vitest run src/test/testCoreServices.test.ts",
    "test:core-session-protocol": "vitest run src/test/testCoreSessionProtocol.test.ts",
    "test:core-e2e": "tsx scripts/qa/coreE2eGate.ts",
    "test:e2e": "playwright test",
    "test:e2e:upnp": "playwright test tests/e2e/upnp-delivery.spec.ts",
    "test:e2e:core": "playwright test tests/e2e/core-and-pwa.spec.ts",
    "test:diagnostics": "vitest run src/test/testDebugDiagnostics.test.ts",
    "test:settings": "vitest run src/test/testCadenceSettingsModal.test.ts",
    "test:upnp-delivery": "vitest run src/test/testUpnpDelivery.test.ts",
    "test:upnp-delivery-ui": "tsx scripts/qa/upnpDeliveryQa.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "music-metadata": "^11.15.0",
    "music-metadata-browser": "^2.5.11",
    "node-id3": "^0.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.1.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.1.2"
  }
}
